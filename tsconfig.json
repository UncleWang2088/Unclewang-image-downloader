{
    "compilerOptions": {
        "composite": true,
        "esModuleInterop": true,
        "importHelpers": true,
        "isolatedModules": true,
        "jsx": "react",
        "module": "ESNext",
        "moduleResolution": "Node",
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "strict": true,
        "target": "ESNext",
        "useUnknownInCatchVariables": true,
        "outDir": "dist/tsc"
    },
    "include": ["src/**/*"],
    "references": [{ "path": "./libs/common" }]
}
